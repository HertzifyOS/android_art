package {
    default_applicable_licenses: ["art_license"],
}

// --- ahat.jar ----------------
java_binary_host {
    name: "ahat",
    visibility: [
        "//libcore/metrictests/memory/host",
    ],
    wrapper: "ahat.sh",
    srcs: ["src/main/**/*.java"],
    manifest: "etc/ahat.mf",
    java_resources: ["etc/style.css"],
    // Use a relaxed version to allow distribution against older runtimes.
    java_version: "11",
    javacflags: ["-Xdoclint:all/protected"],
}

// --- ahat-test-dump.jar --------------
java_test_helper_library {
    name: "ahat-test-dump",
    srcs: ["src/test-dump/**/*.java"],
    sdk_version: "core_platform",
    optimize: {
        obfuscate: true,
        enabled: true,
        proguard_flags_files: ["etc/test-dump.pro"],
    },
}

// --- ahat-ri-test-dump.jar -------
java_test_helper_library {
    host_supported: true,
    device_supported: false,
    name: "ahat-ri-test-dump",
    srcs: ["src/ri-test-dump/**/*.java"],
}

java_binary_host {
    name: "ahat-ri-test-dump-bin",
    static_libs: ["ahat-ri-test-dump"],
    main_class: "Main",
}

cc_library_shared {
    name: "libahat-test-jni",
    srcs: ["src/test/jni/**/*.cpp"],
    header_libs: ["jni_headers"],
    host_supported: true,
}

java_genrule {
    name: "ahat-test-dump-gen",
    srcs: [
        "ahat-test-dump-gen.sh.in",
        ":ahat-test-dump",
    ],
    out: ["ahat-test-dump-gen.sh"],
    cmd: "sed -e s=@AHAT_TEST_DUMP_JAR@=$(location :ahat-test-dump)= $(location ahat-test-dump-gen.sh.in) > $(out)",
}

// Run ahat-ri-test-dump to generate ri-test-dump.hprof
genrule {
    name: "ahat_ri_test_dump_hprof",
    out: ["ri-test-dump.hprof"],
    tools: ["ahat-ri-test-dump-bin"],
    cmd: "$(location ahat-ri-test-dump-bin) $(out)",
}

// To run these tests, use: atest ahat-tests --host
java_test_host {
    name: "ahat-tests",
    srcs: ["src/test/**/*.java"],
    manifest: "etc/ahat-tests.mf",
    java_resources: [
        ":ahat_ri_test_dump_hprof",
        ":ahat-tests-res",
    ],
    static_libs: [
        "ahat",
        "junit-host",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: ["general-tests"],
}

cc_genrule {
    name: "art_common_static_host_libs_zip_64",
    host_supported: true,
    device_supported: false,
    compile_multilib: "64",
    srcs: [
        ":libbase",
        ":libc++",
        ":libicu",
        ":libicu_jni",
        ":liblog",
        ":libsigchain",
        ":libunwindstack",
        ":libziparchive",
        ":libjavacore",
        ":libandroidio",
        ":libopenjdkd",
        ":liblz4",
        ":liblzma",
        ":libcrypto",
        ":libz",
        ":libicuuc",
        ":libicui18n",
        ":libexpat",
    ],
    tools: ["soong_zip"],
    out: ["art_common_static_libs_64.zip"],
    cmd: "TEMP_DIR=$(genDir)/tmp64 && rm -rf $$TEMP_DIR && " +
        "LIB_DIR=$$TEMP_DIR/host/testcases/art_common/out/host/linux-x86/lib64 && " +
        "mkdir -p $$LIB_DIR && " +
        "cp $(location :libbase) $$LIB_DIR/libbase.so && " +
        "cp $(location :libc++) $$LIB_DIR/libc++.so && " +
        "cp $(location :libicu) $$LIB_DIR/libicu.so && " +
        "cp $(location :libicu_jni) $$LIB_DIR/libicu_jni.so && " +
        "cp $(location :liblog) $$LIB_DIR/liblog.so && " +
        "cp $(location :libsigchain) $$LIB_DIR/libsigchain.so && " +
        "cp $(location :libunwindstack) $$LIB_DIR/libunwindstack.so && " +
        "cp $(location :libziparchive) $$LIB_DIR/libziparchive.so && " +
        "cp $(location :libjavacore) $$LIB_DIR/libjavacore.so && " +
        "cp $(location :libandroidio) $$LIB_DIR/libandroidio.so && " +
        "cp $(location :libopenjdkd) $$LIB_DIR/libopenjdkd.so && " +
        "cp $(location :liblz4) $$LIB_DIR/liblz4.so && " +
        "cp $(location :liblzma) $$LIB_DIR/liblzma.so && " +
        "cp $(location :libcrypto) $$LIB_DIR/libcrypto-host.so && " +
        "cp $(location :libz) $$LIB_DIR/libz-host.so && " +
        "cp $(location :libicuuc) $$LIB_DIR/libicuuc-host.so && " +
        "cp $(location :libicui18n) $$LIB_DIR/libicui18n-host.so && " +
        "cp $(location :libexpat) $$LIB_DIR/libexpat-host.so && " +
        "$(location soong_zip) -o $(out) -C $$TEMP_DIR -D $$TEMP_DIR/host",
}

cc_genrule {
    name: "art_common_static_host_libs_zip_32",
    host_supported: true,
    device_supported: false,
    compile_multilib: "32",
    srcs: [
        ":libbase",
        ":libc++",
        ":libicu",
        ":libicu_jni",
        ":liblog",
        ":libsigchain",
        ":libunwindstack",
        ":libziparchive",
        ":libjavacore",
        ":libandroidio",
        ":libopenjdkd",
        ":liblz4",
        ":liblzma",
        ":libcrypto",
        ":libz",
        ":libicuuc",
        ":libicui18n",
        ":libexpat",
    ],
    tools: ["soong_zip"],
    out: ["art_common_static_libs_32.zip"],
    cmd: "TEMP_DIR=$(genDir)/tmp32 && rm -rf $$TEMP_DIR && " +
        "LIB_DIR=$$TEMP_DIR/host/testcases/art_common/out/host/linux-x86/lib && " +
        "mkdir -p $$LIB_DIR && " +
        "cp $(location :libbase) $$LIB_DIR/libbase.so && " +
        "cp $(location :libc++) $$LIB_DIR/libc++.so && " +
        "cp $(location :libicu) $$LIB_DIR/libicu.so && " +
        "cp $(location :libicu_jni) $$LIB_DIR/libicu_jni.so && " +
        "cp $(location :liblog) $$LIB_DIR/liblog.so && " +
        "cp $(location :libsigchain) $$LIB_DIR/libsigchain.so && " +
        "cp $(location :libunwindstack) $$LIB_DIR/libunwindstack.so && " +
        "cp $(location :libziparchive) $$LIB_DIR/libziparchive.so && " +
        "cp $(location :libjavacore) $$LIB_DIR/libjavacore.so && " +
        "cp $(location :libandroidio) $$LIB_DIR/libandroidio.so && " +
        "cp $(location :libopenjdkd) $$LIB_DIR/libopenjdkd.so && " +
        "cp $(location :liblz4) $$LIB_DIR/liblz4.so && " +
        "cp $(location :liblzma) $$LIB_DIR/liblzma.so && " +
        "cp $(location :libcrypto) $$LIB_DIR/libcrypto-host.so && " +
        "cp $(location :libz) $$LIB_DIR/libz-host.so && " +
        "cp $(location :libicuuc) $$LIB_DIR/libicuuc-host.so && " +
        "cp $(location :libicui18n) $$LIB_DIR/libicui18n-host.so && " +
        "cp $(location :libexpat) $$LIB_DIR/libexpat-host.so && " +
        "$(location soong_zip) -o $(out) -C $$TEMP_DIR -D $$TEMP_DIR/host",
}

// TODO: Move this to art/test after "libopenjdkd" and "libjavacore" are visible
// to art/test.
// This rule packages a set of shared libraries (.so) required by ART host tests.
// The tests are executed by a test runner that needs to find and load these
// shared libraries at runtime. The term "static" in the name refers to the
// statically-defined list of dependencies, not to static libraries (.a).
// The packaged libraries are indeed shared objects (.so). This is necessary
// for the gtest framework which dynamically loads these dependencies.
genrule {
    name: "art_common_static_host_libs",
    tools: ["merge_zips"],
    host_first_srcs: [
        ":art_common_static_host_libs_zip_64",
    ],
    host_second_srcs: [
        ":art_common_static_host_libs_zip_32",
    ],
    out: ["art_common_static_host_libs.zip"],
    cmd: "$(location merge_zips) $(out) $(in)",
}

genrule {
    name: "apex_icu_dat_zip",
    srcs: [
        ":icu_dat",
    ],
    tools: ["soong_zip"],
    out: ["apex_icu_dat.zip"],
    cmd: "TEMP_DIR=$(genDir)/tmp32 && rm -rf $$TEMP_DIR && " +
        "mkdir -p $$TEMP_DIR/host/testcases/art_common/out/host/linux-x86/com.android.i18n/etc/icu && " +
        "cp $(location :icu_dat) $$TEMP_DIR/host/testcases/art_common/out/host/linux-x86/com.android.i18n/etc/icu/ && " +
        "$(location soong_zip) -o $(out) -C $$TEMP_DIR -D $$TEMP_DIR/host",
}
